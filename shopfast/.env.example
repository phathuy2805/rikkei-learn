# Application Configuration
NODE_ENV=development
PORT=3000
JWT_SECRET=shopfast-super-secure-production-jwt-secret-key-32chars

# Database Configuration
# Set DB_TYPE=sqlite for zero-config local run (default)
# Set DB_TYPE=postgres for AWS Docker Compose or RDS
DB_TYPE=sqlite
DB_DATABASE=shopfast.sqlite

# PostgreSQL Settings (When DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=shopfast
