  "item": [
    {
      "name": "GET User 1 Orders - No Params",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 200\", () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response đúng cấu trúc đã thiết kế\", () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('success', true);",
              "  pm.expect(json.data).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/users/1/orders",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "users",
            "1",
            "orders"
          ]
        }
      }
    },
